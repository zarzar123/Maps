# ============================================================
# Bangladesh Flood Exposure Map (≈1984–2024)
# JRC Global Surface Water + Landsat-8/9 + HydroRIVERS
# ============================================================

# If running in Colab:
# !pip install earthengine-api geemap

import ee
import geemap

# ------------------------------------------------------------
# 1. Authenticate & initialize Earth Engine
# ------------------------------------------------------------
try:
    ee.Initialize()
except Exception:
    ee.Authenticate()
    ee.Initialize()

# ------------------------------------------------------------
# 2. Region of interest: Bangladesh (LSIB simplified)
# ------------------------------------------------------------
countries = ee.FeatureCollection("USDOS/LSIB_SIMPLE/2017")
bangladesh = countries.filter(ee.Filter.eq("country_na", "Bangladesh")).geometry()

map_center = [23.7, 90.4]   # near Dhaka

# ============================================================
# PART A — Long-term flood exposure from JRC Global Surface Water
# ============================================================

# JRC Global Surface Water mapping layers (Landsat-based)
gsw = ee.Image("JRC/GSW1_4/GlobalSurfaceWater")

# Water occurrence 1984–2021 (0–100, % of valid observations with water)
occurrence = gsw.select("occurrence").clip(bangladesh)

# Seasonality band: number of months per year with water (0–12)
seasonality = gsw.select("seasonality").clip(bangladesh)

# Mask out permanent water (12 months/year) so we focus on
# flood-prone / seasonal / ephemeral water
non_permanent_mask = seasonality.lt(12).And(occurrence.gt(0))
flood_occurrence = occurrence.updateMask(non_permanent_mask)

# Normalize to 0–1 (0 = no water detected, 1 = 100% of observations water)
flood_occ_norm = flood_occurrence.divide(100).rename("flood_exposure_longterm")

# Visualization (blue gradient)
flood_occ_vis = {
    "min": 0.0,
    "max": 1.0,
    "palette": [
        "f7fbff", "deebf7", "c6dbef",
        "9ecae1", "6baed6", "3182bd", "08519c"
    ],
}

# ============================================================
# PART B — Recent monsoon flood frequency from Landsat-8/9 SR
# ============================================================

def mask_landsat_l2_sr(image):
    """Mask clouds, cloud shadow, snow using QA_PIXEL for L8/L9 SR."""
    qa = image.select("QA_PIXEL")
    # Bits: 3 = cloud shadow, 4 = snow, 5 = cloud, 7 = cirrus
    cloud_shadow = qa.bitwiseAnd(1 << 3).neq(0)
    snow        = qa.bitwiseAnd(1 << 4).neq(0)
    cloud       = qa.bitwiseAnd(1 << 5).neq(0)
    cirrus      = qa.bitwiseAnd(1 << 7).neq(0)
    mask = cloud_shadow.Or(snow).Or(cloud).Or(cirrus).Not()

    return (
        image.updateMask(mask)
        .select(
            ["SR_B2", "SR_B3", "SR_B4", "SR_B5"],
            ["blue", "green", "red", "nir"]
        )
    )

# Landsat-8/9 Surface Reflectance
ls8 = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2")
ls9 = ee.ImageCollection("LANDSAT/LC09/C02/T1_L2")

landsat = (
    ls8.merge(ls9)
    .filterBounds(bangladesh)
    .filterDate("2013-01-01", "2024-12-31")
    .map(mask_landsat_l2_sr)
)

# Focus on monsoon months for flood exposure (Jun–Oct)
landsat_monsoon = landsat.filter(ee.Filter.calendarRange(6, 10, "month"))

def add_ndwi_and_water_flag(image):
    """Compute NDWI and flag water pixels."""
    # Scale factor + offset for SR bands
    scale = 0.0000275
    offset = -0.2
    green = image.select("green").multiply(scale).add(offset)
    nir   = image.select("nir").multiply(scale).add(offset)

    ndwi = green.subtract(nir).divide(green.add(nir)).rename("NDWI")

    # Threshold NDWI > 0.2 as water (simple, conservative)
    water = ndwi.gt(0.2).rename("water_flag")

    return image.addBands([ndwi, water])

landsat_water = landsat_monsoon.map(add_ndwi_and_water_flag)

# Fraction of monsoon scenes where water was detected (0–1)
water_flags = landsat_water.select("water_flag")
water_sum   = water_flags.sum().clip(bangladesh)
water_count = water_flags.count().clip(bangladesh)

flood_freq_recent = water_sum.divide(water_count).rename("flood_exposure_recent")

# Visualization for recent flood frequency
recent_flood_vis = {
    "min": 0.0,
    "max": 1.0,
    "palette": [
        "ffffe5", "fff7bc", "fee391",
        "fec44f", "fe9929", "ec7014", "cc4c02", "993404"
    ],
}

# ============================================================
# PART C — Major rivers overlay (HydroSHEDS FreeFlowingRivers)
# ============================================================

rivers = (
    ee.FeatureCollection("WWF/HydroSHEDS/v1/FreeFlowingRivers")
    .filterBounds(bangladesh)
)

rivers_vis = {
    "color": "0000ff",  # blue
    "width": 1
}

# ============================================================
# PART D — Map visualization
# ============================================================

m = geemap.Map(center=map_center, zoom=7)

# Long-term flood exposure (GSW)
m.addLayer(
    flood_occ_norm,
    flood_occ_vis,
    "Long-term flood exposure (GSW 1984–2021)"
)

# Recent monsoon flood frequency (Landsat-8/9 NDWI)
m.addLayer(
    flood_freq_recent,
    recent_flood_vis,
    "Recent monsoon flood frequency (L8/L9 2013–2024)"
)

# Rivers overlay (no .style() call; style via vis params)
m.addLayer(rivers, rivers_vis, "Major rivers (HydroSHEDS)")

# Colorbar for long-term exposure
m.add_colorbar_branca(
    colors=flood_occ_vis["palette"],
    vmin=0,
    vmax=1,
    caption="Long-term flood exposure (0 = never, 1 = always water)",
)

m.addLayerControl()
m
